# Template for `.streamlit/secrets.toml` (gitignored — see .gitignore).
#
# The app currently needs NO secrets to run — the default "Synthetic
# (zero setup)" source and the sidebar's plain-text checkpoint path field
# don't require any credentials. This file exists as the standard
# Streamlit Community Cloud secrets-template location and documents the
# one optional value the app will read if present, for future use (e.g.
# pointing at a checkpoint hosted somewhere that needs auth, or a
# non-default LSL stream name on a shared lab machine).
#
# To use: copy this file to `.streamlit/secrets.toml` (untracked) and fill
# in real values, or set the same keys as environment variables / via the
# Streamlit Community Cloud "Secrets" dashboard when deploying.

# default_checkpoint_url = ""   # optional: pre-fill the sidebar checkpoint field
# lsl_stream_name = "EEG"       # optional: override the default LSL stream type lookup
